# PostgreSQL / Supabase connection (choose one)
# For Supabase you can set DATABASE_URL directly (recommended)
DATABASE_URL=postgresql://user:password@dbhost:5432/dbname

# Or set individual components (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_ai_platform
DB_USER=postgres
DB_PASSWORD=yourpassword

# JWT secret used by the app
JWT_SECRET=change_me_to_a_secure_value

# Server port (optional)
PORT=5000
